{
  "name": "gh-ssh",
  "version": "1.0.0",
  "description": "Interactive CLI that guides you through creating or reusing SSH keys and connecting them to GitHub.",
  "license": "MIT",
  "type": "module",
  "author": "Juncen Zhou <juncenzhou@higherbros.me>",
  "keywords": [
    "ssh",
    "github",
    "cli",
    "ssh-keygen",
    "ssh-agent",
    "developer-tools",
    "key-management",
    "terminal"
  ],
  "homepage": "https://github.com/higherbros/gh-ssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higherbros/gh-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/higherbros/gh-ssh/issues"
  },
  "bin": {
    "gh-ssh": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "format": "prettier --write 'src/**/*.ts'",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "lint:fix": "eslint 'src/**/*.{ts,js}' --fix",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.12.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
