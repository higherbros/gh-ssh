{
  "name": "gh-ssh",
  "version": "0.1.0",
  "description": "A simple, safe, one-command tool to generate and configure SSH keys for GitHub on macOS.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gh-ssh": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.1"
  }
}
